{
  "name": "stellaryield-backend",
  "version": "1.0.0",
  "description": "StellarYield backend API and indexer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "node dist/database/migrate.js",
    "indexer": "node dist/indexer/index.js",
    "operator-expiry-task": "node dist/tasks/operatorExpiry.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^11.3.0",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "@types/cors": "^2.8.17",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0"
  }
}
